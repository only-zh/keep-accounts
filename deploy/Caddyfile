# 记账本 · Caddy 反向代理（更省事：自动申请并续期 HTTPS 证书）
# 用法：sudo cp deploy/Caddyfile /etc/caddy/Caddyfile && sudo systemctl reload caddy
# 前提：把域名 A 记录指向服务器，并且 80/443 已在安全组放行
#
# 国内服务器：用域名走 80/443 需要 ICP 备案；未备案时请用 http://IP:8787 直连，
# 或把站点改为 http://:8788 之类的非标端口（但不建议，登录凭证会明文传输）。

ledger.example.com {
	encode zstd gzip

	reverse_proxy 127.0.0.1:8787 {
		# 大模型解析 + 语音上传：放宽超时与体积
		transport http {
			read_timeout 120s
			write_timeout 120s
		}
		flush_interval -1
	}

	request_body {
		max_size 30MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
}
