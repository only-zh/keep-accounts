# 记账本 · 备份任务（配合 keep-accounts-backup.timer）
# 安装：sudo cp deploy/keep-accounts-backup.{service,timer} /etc/systemd/system/
#       sudo systemctl daemon-reload && sudo systemctl enable --now keep-accounts-backup.timer
[Unit]
Description=记账本 数据库备份
After=keep-accounts.service

[Service]
Type=oneshot
User=keep
Group=keep
WorkingDirectory=/opt/keep-accounts
Environment=APP_DIR=/opt/keep-accounts
ExecStart=/usr/bin/env bash /opt/keep-accounts/deploy/backup.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=keep-accounts-backup

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/keep-accounts/backups
