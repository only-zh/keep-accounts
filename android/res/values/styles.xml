<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Platform theme only - no AppCompat / MaterialComponents (no AndroidX in this project).
      Theme.Material.NoActionBar exists since API 21, so it is safe for minSdk 26.
    -->
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:statusBarColor">@color/status_bar</item>
        <item name="android:navigationBarColor">@color/navigation_bar</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:colorPrimary">@color/background</item>
        <item name="android:colorPrimaryDark">@color/status_bar</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/on_background</item>
        <item name="android:textColorSecondary">@color/on_background_dim</item>
        <item name="android:textColorPrimaryInverse">@color/background</item>
        <!-- Dark theme => light (white) status bar icons. -->
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
