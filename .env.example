# ============================================================
# 复制为 .env 后填写。所有密钥只留在服务端，不会下发到前端。
# ============================================================

# ---- 服务 ----
PORT=8787
# 本机开发/内测：0.0.0.0（手机可直接访问 IP:8787）
# 正式部署：127.0.0.1（只给 Nginx/Caddy 转发，不直接暴露端口）
# 注意：deploy/keep-accounts.service 里用 Environment 钉死了 127.0.0.1，环境变量优先级高于本文件
HOST=0.0.0.0
DB_PATH=./data/ledger.db
TZ=Asia/Shanghai
# 额外的接口口令（可选，留空即可；账号登录是主要鉴权方式）
AUTH_TOKEN=

# ---- 大模型（DeepSeek）----
# auto = 有 Key 用 deepseek，没有则用演示模型（走规则但格式与模型一致）
# deepseek | mock | none
LLM_PROVIDER=auto
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT_MS=45000

# ---- 语音识别（可选，OpenAI 兼容接口）----
ASR_PROVIDER=none
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=whisper-1
ASR_LANGUAGE=zh

# ---- 邮件（注册验证码）----
# auto = 配了 SMTP_HOST 就发真邮件，否则走开发模式（验证码回显在注册页 + 打印到日志）
# smtp | none | auto
MAIL_PROVIDER=auto
# QQ 邮箱：smtp.qq.com + 465 + ssl，密码填「授权码」
SMTP_HOST=
SMTP_PORT=465
# ssl = 465 直连 TLS；starttls = 587；none = 25
SMTP_SECURE=ssl
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=记账本
SMTP_TIMEOUT_MS=15000
SMTP_REJECT_UNAUTHORIZED=true

# ---- 账号与配额 ----
# 每个账号最多能创建几个账本
MAX_BOOKS_PER_ACCOUNT=10
# 每个账本最多几个成员（含创建者）
MAX_MEMBERS_PER_BOOK=5
# 会话有效期（天）
SESSION_DAYS=30
# 验证码有效期（分钟）、重发间隔（秒）、每小时上限、单码最大尝试次数
CODE_TTL_MINUTES=10
CODE_RESEND_SECONDS=60
CODE_MAX_PER_HOUR=6
CODE_MAX_ATTEMPTS=5
# 未配置 SMTP 时是否把验证码回显给前端（仅本地开发用，上线必须 false）
DEV_SHOW_CODE=auto

# ---- 业务默认值 ----
# 大额消费阈值（分）：默认 5000 = 50 元
LARGE_THRESHOLD_CENTS=5000
